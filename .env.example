# Copy to .env.local and fill in from your Supabase project's
# Project Settings -> API. `.env*` is gitignored.
#
# Both values below are safe in browser code: the publishable (anon) key only
# ever gets the access Row Level Security grants it.
#
# The service_role key and the database password are NOT used anywhere in this
# project, and must never be added here. Any privileged access this app needs
# is expressed as an RLS policy instead.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
